#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        /* Combo E + R = é */

        combo_e_aigu {
            timeout-ms = <50>;
            key-positions = <3 4>;
            bindings = <&kp N2>;
            layers = <0>;
        };

        /* Combo Z + E = è */

        combo_e_grave {
            timeout-ms = <50>;
            key-positions = <2 3>;
            bindings = <&kp N7>;
            layers = <0>;
        };

        /* Combo A + Z = à */

        combo_a_grave {
            timeout-ms = <50>;
            key-positions = <1 2>;
            bindings = <&kp N0>;
            layers = <0>;
        };

        /* Combo X + C = ç */

        combo_c_cedille {
            timeout-ms = <50>;
            key-positions = <26 27>;
            bindings = <&kp N9>;
            layers = <0>;
        };

        /* Combo U + I = ù */

        combo_u_grave {
            timeout-ms = <50>;
            key-positions = <7 8>;
            bindings = <&kp SQT>;
            layers = <0>;
        };

        /* Combo I + O = ^ */

        combo_circonflexe {
            timeout-ms = <50>;
            key-positions = <8 9>;
            bindings = <&kp LBKT>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp BSPC  &kp ESC  &mt LGUI A  &mt LALT S  &mt LCTRL D  &mt LSHFT F  &kp G  &kp H  &mt LSHFT J  &mt LCTRL K  &mt LALT L  &mt LGUI SEMI  &kp N4  &kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp PRINTSCREEN  &lt 3 LGUI  &mo 1  &kp SPACE  &kp RET  &mo 2  &kp RALT
            >;
        };

        low_layer {
            bindings = <
&kp TAB  &trans  &trans  &trans  &trans  &trans  &kp KP_NUM  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_MULTIPLY  &kp BSPC  &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &kp RA(N4)  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp RA(EQUAL)  &kp RBKT  &kp LSHFT  &trans  &trans  &trans  &trans  &trans  &kp N1  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp LS(SQT)  &kp RA(N2)  &kp LGUI  &trans  &kp SPACE  &kp RET  &kp KP_N0  &kp RALT
            >;
        };

        raise_layer {
            bindings = <
&kp RA(N7)  &kp N3  &kp N4  &kp EQUAL  &kp N5  &kp MINUS  &trans  &trans  &trans  &trans  &trans  &kp BSPC  &kp LCTRL  &kp RA(N0)  &kp RA(N5)  &kp RA(MINUS)  &kp NUBS  &kp LS(NUBS)  &trans  &trans  &trans  &trans  &trans  &trans  &kp RA(N8)  &kp RA(N3)  &kp N8  &kp LS(EQUAL)  &kp N6  &kp RA(N6)  &trans  &trans  &trans  &trans  &trans  &trans  &kp LGUI  &trans  &kp SPACE  &kp RET  &trans  &kp RALT
            >;
        };

        nav_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &kp PG_UP  &kp HOME  &kp UP  &kp END  &trans  &kp DEL  &trans  &trans  &trans  &trans  &trans  &trans  &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
